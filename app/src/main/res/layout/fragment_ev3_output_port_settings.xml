<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools" android:layout_width="match_parent"
    android:layout_height="match_parent" tools:context="ru.proghouse.robocam.EV3OutputPortSettings">

    <!-- TODO: Update blank fragment layout -->

    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="6dp"
        android:paddingBottom="6dp">
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textAppearance="?android:attr/textAppearanceLarge"
        android:text="@string/port"
        android:id="@+id/textViewTitle"
        android:layout_gravity="center_horizontal"
        android:background="#90909090"
        android:paddingLeft="11dp"
        android:paddingTop="2dp"
        android:paddingBottom="2dp"
        android:textColor="#ffffff"
        android:textStyle="bold" />

        <Spinner android:id="@+id/spinnerGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            style="@style/SettingsSpinner" />

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:id="@+id/imageView9"
            android:layout_gravity="center_horizontal"
            android:src="@drawable/spacer_small" />

        <Spinner
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:id="@+id/spinnerLayer"
            android:visibility="visible"
            android:spinnerMode="dialog"
            android:focusable="false" />

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:id="@+id/imageView11"
            android:layout_gravity="center_horizontal"
            android:src="@drawable/spacer_small" />

        <Spinner
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:id="@+id/spinnerNumber"
        android:visibility="visible"
        android:spinnerMode="dialog"
        android:focusable="false" />

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:id="@+id/imageView10"
            android:layout_gravity="center_horizontal"
            android:src="@drawable/spacer_small" />

        <Spinner
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:id="@+id/spinnerJoystickType"
            android:visibility="visible"
            android:spinnerMode="dialog"
            android:focusable="false" />

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:id="@+id/imageView12"
            android:layout_gravity="center_horizontal"
            android:src="@drawable/spacer_small" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="?android:attr/textAppearanceLarge"
            android:text="@string/power"
            android:id="@+id/textView5"
            android:layout_gravity="center_horizontal"
            android:paddingLeft="11dp"
            android:paddingTop="6dp" />

        <SeekBar
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:id="@+id/seekBarPower"
            android:progress="60"
            android:paddingRight="11dp"
            android:paddingLeft="11dp" />

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:id="@+id/imageView15"
            android:layout_gravity="center_horizontal"
            android:src="@drawable/spacer_small" />

        <CheckBox
            android:layout_width="match_parent"
            android:layout_height="@dimen/pref_item_height"
            android:text="@string/invert"
            android:id="@+id/checkBoxInvert"
            android:textAppearance="?android:attr/textAppearanceLarge" />

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:id="@+id/imageView13"
            android:layout_gravity="center_horizontal"
            android:src="@drawable/spacer_small" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="?android:attr/textAppearanceLarge"
            android:text="@string/coefficient"
            android:id="@+id/textViewCoefficient"
            android:layout_gravity="center_horizontal"
            android:paddingLeft="11dp"
            android:paddingTop="6dp" />

        <EditText
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="numberDecimal"
            android:ems="10"
            android:id="@+id/editTextCoefficient"
            android:layout_gravity="center_horizontal"
            android:paddingLeft="11dp"
            android:paddingRight="11dp"
            android:singleLine="true"
            android:lines="1" />

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:id="@+id/imageView14"
            android:layout_gravity="center_horizontal"
            android:src="@drawable/spacer_small" />

        <CheckBox
            android:layout_width="match_parent"
            android:layout_height="@dimen/pref_item_height"
            android:text="@string/brake"
            android:id="@+id/checkBoxBrake"
            android:textAppearance="?android:attr/textAppearanceLarge" />
    </LinearLayout>

</FrameLayout>
